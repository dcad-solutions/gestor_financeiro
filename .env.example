# ==========================================
# CONFIGURAÇÕES DO TELEGRAM
# ==========================================
# Token fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# Seu ID numérico do Telegram (para impedir que outras pessoas usem seu bot)
# Você pode descobrir seu ID enviando uma mensagem para o bot @userinfobot no Telegram.
# Para múltiplos usuários, separe por vírgula (ex: 12345678,87654321)
ALLOWED_TELEGRAM_USERS=seu_telegram_id_aqui

# ==========================================
# CONFIGURAÇÃO DA IA (GEMINI)
# ==========================================
# Obtenha gratuitamente em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# ==========================================
# CONFIGURAÇÃO DO GOOGLE SHEETS
# ==========================================
# ID da sua planilha no Google Sheets (pegar da URL da planilha)
# Exemplo de URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# O ID é a parte entre /d/ e /edit
SPREADSHEET_ID=seu_id_da_planilha_aqui

# Caminho para o arquivo JSON de credenciais da Service Account do Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
